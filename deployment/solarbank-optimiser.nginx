# Private HTTP frontend, matching the other home-network Pi applications.
# Any request whose Host is not one of our names is dropped (stops DNS-rebinding pages); the application checks again.
server {
    listen 8091 default_server;
    listen [::]:8091 default_server;
    server_name _;
    return 444;
}

server {
    listen 8091;
    listen [::]:8091;
    server_name solarbank-pi.local solarbank-pi solarbank-pi.your-tailnet.ts.net "~^(\d{1,3}\.){3}\d{1,3}$";
    allow 127.0.0.1;
    allow 192.168.1.0/24;
    allow 100.64.0.0/10;
    # IPv6: this machine, link-local and private (ULA) addresses, Tailscale, and the home network's own /64 (browsers on the LAN
    # often reach a .local name over IPv6). The /64 is the ISP-assigned prefix: it is NOT here but in /etc/solarbank-cost-optimiser/lan-prefixes (one prefix per
    # line), which the deploy turns into the include below, and which the dashboard reads too. Edit that file if the ISP changes the prefix.
    allow ::1;
    allow fe80::/10;
    allow fc00::/7;
    allow fd7a:115c:a1e0::/48;
    include /etc/nginx/solarbank-optimiser-lan.conf;
    deny all;
    client_max_body_size 16k;
    location / {
        proxy_pass http://127.0.0.1:8092;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_read_timeout 15s;
    }
}
